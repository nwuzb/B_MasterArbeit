# Construct ffmpeg command
crop_filter = f"crop={crop_w}:{crop_h}:{crop_x}:{crop_y}"
cmd = [
    FFMPEG_PATH, "-y",
    "-ss", start_time,
    "-to", end_time,
    "-i", video_path,
    "-vf", crop_filter,
    "-c:v", "libx264",
    "-crf", "15",  # High quality, almost lossless
    "-preset", "veryslow",
    "-an",  # Remove audio
    out_path
]
