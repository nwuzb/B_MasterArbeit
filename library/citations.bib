	month = jul,
	note = {arXiv:2206.14651 [cs] TLDR: A new robust state-of-the-art tracker, which can combine the advantages of motion and appearance information, along with camera-motion compensation, and a more accurate Kalman filter state vector is presented.},
	publisher = {arXiv},
	shorttitle = {{BoT}-{SORT}},
	title = {93\_BoT-{SORT}: {Robust} {Associations} {Multi}-{Pedestrian} {Tracking}},
