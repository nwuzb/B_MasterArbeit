	editor = {Leonardis, Ale{\v s} and Ricci, Elisa and Roth, Stefan and Russakovsky, Olga and Sattler, Torsten and Varol, G{\"u}l},
	file = {PDF:/Users/binzeng/Zotero/storage/9ZV2ZBFV/Li et al. - 2025 - Beyond MOT Semantic Multi-object Tracking.pdf:application/pdf},
