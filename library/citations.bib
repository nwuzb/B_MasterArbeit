}

@misc{218,
  title = {218\_{{Not Every Patch}} Is {{Needed}}: {{Towards}} a {{More Efficient}} and {{Effective Backbone}} for {{Video-based Person Re-identification}}},
  shorttitle = {Not {{Every Patch}} Is {{Needed}}},
  author = {Zhu, Lanyun and Chen, Tianrun and Ji, Deyi and Ye, Jieping and Liu, Jun},
  year = {2025},
  month = jan,
  number = {arXiv:2501.16811},
  eprint = {2501.16811},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.16811},
  url = {http://arxiv.org/abs/2501.16811},
  urldate = {2025-09-01},
  abstract = {This paper proposes a new effective and efficient plug-and-play backbone for video-based person re-identification (ReID). Conventional video-based ReID methods typically use CNN or transformer backbones to extract deep features for every position in every sampled video frame. Here, we argue that this exhaustive feature extraction could be unnecessary, since we find that different frames in a ReID video often exhibit small differences and contain many similar regions due to the relatively slight movements of human beings. Inspired by this, a more selective, efficient paradigm is explored in this paper. Specifically, we introduce a patch selection mechanism to reduce computational cost by choosing only the crucial and non-repetitive patches for feature extraction. Additionally, we present a novel network structure that generates and utilizes pseudo frame global context to address the issue of incomplete views resulting from sparse inputs. By incorporating these new designs, our backbone can achieve both high performance and low computational cost. Extensive experiments on multiple datasets show that our approach reduces the computational cost by 74{\textbackslash}\% compared to ViT-B and 28{\textbackslash}\% compared to ResNet50, while the accuracy is on par with ViT-B and outperforms ResNet50 significantly.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {/unread,Computer Science - Computer Vision and Pattern Recognition},
  file = {/Users/binzeng/Zotero/storage/P4TDVK44/Zhu 等 - 2025 - Not Every Patch is Needed Towards a More Efficient and Effective Backbone for Video-based Person Re.pdf;/Users/binzeng/Zotero/storage/YXQRUGSG/2501.html}
}


