	file = {PDF:/Users/binzeng/Zotero/storage/FFED6BGA/Duan  - 2024 - Multi-Target Irregular Behavior Recognition of Chemical Laboratory Personnel Based on Improved DeepS.pdf:application/pdf},
}

@article{182,
	title = {182\_Dynamic {Tracking} {Method} {Based} on {Improved} {DeepSORT} for {Electric} {Vehicle}},
	volume = {15},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2032-6653},
