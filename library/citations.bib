	file = {PDF:/Users/binzeng/Zotero/storage/YCNT2HT5/Sekharamantry  - 2024 - A Seamless Deep Learning Approach for Apple Detection, Depth Estimation, and Tracking Using YOLO Mod.pdf:application/pdf},
