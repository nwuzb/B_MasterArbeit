@inproceedings{rawat_deep_2024,
  abstract = {Advancements in technology have led to the widespread use of the automatic passenger count ({APC}) system. {APC} facilitates informed decision-making for passengers in terms of pre-trip planning and optimal usage of transit vehicles for the operators. To make this aspect of passenger mobility efficient and convenient, methods that focus on video-based passenger counting systems are required. This paper proposes a passenger counting model using existing surveillance cameras in transit vehicles. For this, the {YOLOv}8 object detection algorithm is used with the {deepSORT} tracking algorithm. The state of the door is identified using the Hough Transformation and Canny edge detection methods. The proposed algorithm is applied to videos from the {CCTV} of the buses in Bengaluru. The output from the demonstration indicates that the proposed method performs better under all possible conditions.},
  author = {Rawat, Nishtha and Rai, Arnav and Agarwal, Amit},
  booktitle = {2024 16th International Conference on {COMmunication} Systems \& {NETworkS} ({COMSNETS})},
  doi = {10.1109/COMSNETS59351.2024.10426937},
  eventtitle = {2024 16th International Conference on {COMmunication} Systems \& {NETworkS} ({COMSNETS})},
  langid = {american},
  note = {{ISSN}: 2155-2509},
  pages = {234--239},
  title = {Deep Learning-Based Passenger Counting System Using Surveillance Cameras},
  url = {https://ieeexplore.ieee.org/document/10426937},
  urldate = {2024-12-14},
  year = {2024-01}
}

@article{recalde_low-cost_2021,
  abstract = {Due to the high rate of passenger traffic in public transport in Paraguay, it has become indispensable for public transport companies to implement specific methods for the organization and management of the service. Transportation companies have begun to take into account passenger counting, which could optimize the deployment of the vehicle fleet, make a more appropriate budget distribution among the different companies, and improve the service in general. This work aims to provide a low-cost analysis system for bus passenger traffic, geo-referencing the {GPS} positions where people get on and off the bus, also adding data based on parameters such as weather, temperature and humidity, among others. The counting system consists of a Jetson Nano running a {MobileNet} V2 {SSD} network for person detection and a tracking algorithm in conjunction with a {CSI} camera placed in a zenithal position to obtain the images. Data acquisition and network training were performed entirely on the Jetson Nano. The results show that the developed system can process video at a resolution of 640x480 pixels at 30 fps, and can count passengers in different lighting conditions with an accuracy of 94\%.},
  author = {Recalde, Gustavo and Gregor, Derlis and Britez, David and Arzamendia, Mario},
  doi = {10.1109/CHILECON54041.2021.9703018},
  journal = {2021 {IEEE} {CHILEAN} Conference on Electrical, Electronics Engineering, Information and Communication Technologies ({CHILECON})},
  note = {Conference Name: 2021 {IEEE} {CHILEAN} Conference on Electrical, Electronics Engineering, Information and Communication Technologies ({CHILECON})
{ISBN}: 9781665408738
Place: Valparaíso, Chile
Publisher: {IEEE}},
  pages = {1--4},
  rights = {https://doi.org/10.15223/policy-029},
  title = {Low-cost in-bus people counting system for the reordering of urban passenger traffic based on artificial vision and neural networks},
  url = {https://ieeexplore.ieee.org/document/9703018/},
  urldate = {2024-12-14},
  year = {2021-12-06}
}

