	publisher = {arXiv},
	author = {Zhang, Yifu and Wang, Xinggang and Ye, Xiaoqing and Zhang, Wei and Lu, Jincheng and Tan, Xiao and Ding, Errui and Sun, Peize and Wang, Jingdong},
