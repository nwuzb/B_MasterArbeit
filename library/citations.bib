@article{82_EvaluatingMultipleObject_bernardin2008,
	abstract = {在现实世界环境中，同时跟踪多个人是一个主动的研究领域，并且根据各种功能和算法提出了几种方法。最近，对组织系统评估进行比较各种技术的兴趣越来越大。不幸的是，缺乏测量多个对象跟踪器性能的常见指标仍然很难比较其结果。在这项工作中，我们介绍了两个直观和一般的指标，以实现跟踪器特征的客观比较，重点是它们在估计对象位置的精确度，它们在识别对象配置方面的准确性以及它们随着时间的推移始终如一地标记对象的能力。这些指标已在两个大规模的国际评估（2006年和2007年的清晰评估）中广泛使用，以测量和比较多种对象跟踪器的性能，以完成各种跟踪任务。提出了选定的绩效结果，并根据评估过程中获得的经验讨论了所提出的指标的优点和缺点。},
	author = {Bernardin, Keni and Stiefelhagen, Rainer},
	doi = {10.1155/2008/246309},
	file = {PDF:/Users/binzeng/Zotero/storage/38QVYG6H/Bernardin and Stiefelhagen - 2008 - Evaluating Multiple Object Tracking Performance The CLEAR MOT Metrics.pdf:application/pdf},
	issn = {1687-5176, 1687-5281},
	journal = {EURASIP Journal on Image and Video Processing},
	language = {en},
	note = {TLDR: This work introduces two intuitive and general metrics to allow for objective comparison of tracker characteristics, focusing on their precision in estimating object locations, their accuracy in recognizing object configurations and their ability to consistently label objects over time. titleTranslation: 评估多个对象跟踪性能：清晰的MOT指标},
	pages = {1--10},
	shorttitle = {02\_Evaluating},
	title = {82\_Evaluating {Multiple} {Object} {Tracking} {Performance}: {The} {CLEAR} {MOT} {Metrics}},
